# Copy to .env and edit. .env is gitignored and must never be committed.
# On the Linux server the only flag you normally flip is GS_MOCK.

# ---------------------------------------------------------------- mode
GS_MOCK=1                 # 1 = simulators (Windows dev). 0 = real hardware.
GS_OFFLINE=0              # 1 = serve fixtures instead of hitting the internet
GS_LOG_LEVEL=info

# ---------------------------------------------------------------- station
GS_STATION_ID=5024
GS_STATION_NAME=INSTED-Ground Station(UHF)
GS_STATION_LAT=13.823781779271652
GS_STATION_LON=100.51295302800892
GS_STATION_ALT_M=60
GS_STATION_GRID=OK03gt
# Match the station's own SatNOGS settings, or our pass times will not agree
# with the schedule it records to. Station 5024: min_horizon 0, min_culmination 10.
GS_MIN_ELEVATION_DEG=0.0
GS_MIN_CULMINATION_DEG=10.0
GS_TIMEZONE=Asia/Bangkok

# ---------------------------------------------------------------- satellites
GS_DEFAULT_NORAD=67683                       # KNACKSAT-2
GS_PINNED_NORAD=67683                        # always in the selector, comma separated
GS_CELESTRAK_GROUP=amateur                   # full amateur list for the selector
GS_TLE_TTL_S=7200                            # Celestrak 403s below this. Do not lower.
GS_TLE_STALE_WARN_D=7
GS_TLE_STALE_CRIT_D=14
GS_TRANSMITTER_TTL_S=86400                   # transmitters change on the scale of months

# ---------------------------------------------------------------- rotator
# rigctld defaults to 4532 (RADIO), rotctld to 4533 (ROTATOR).
# Confirmed on site 2026-09-13: 4533 is a SPID Rot2Prog model 901; 4532 is
# closed. Re-check with deploy/commissioning/01_rotator_port.py if the rack
# changes — it is read-only and safe to run during a pass.
GS_ROTCTLD_HOST=10.90.36.140
GS_ROTCTLD_PORT=4533
GS_ROTCTLD_PROTOCOL=auto                     # auto | rotctld | rigctld — auto refuses to poll a rig
GS_ROTATOR_POLL_HZ=1.0                       # NOT 2.0: 600-baud ROT2PROG cannot sustain it
GS_ROTATOR_BACKOFF_MIN_S=5
GS_ROTATOR_BACKOFF_MAX_S=10
GS_MOCK_FAULT_PERIOD_S=600                   # mock injects an RPRT -5 outage this often

# The rotator's REAL travel limits. These are NOT what dump_caps reports:
# dump_caps returns the Hamlib backend's compiled range (for a SPID 901,
# el -20..210), and the limits actually in force come from rotctld's own -C
# flags and from what satnogs-client pushes. On station 5024:
#   rotctld  -C min_az=-180,max_az=540,min_el=0,max_el=100
#   satnogs  SATNOGS_ROT_SET_CONF min_az=-90,max_az=450,min_el=-5,max_el=100
# The backend clamps to the INTERSECTION of these and dump_caps, so a wrong
# value here can only narrow the range, never open it past the hardware.
# Check with:  ssh the station, then  ps -eo args | grep rotctld
GS_ROT_LIMIT_MIN_AZ=-90
GS_ROT_LIMIT_MAX_AZ=450
GS_ROT_LIMIT_MIN_EL=0
GS_ROT_LIMIT_MAX_EL=100

# ---------------------------------------------------------------- rotator control
# Control is refused unless ALL gates pass. Default off; turn on deliberately.
GS_ROTATOR_CONTROL_ENABLED=0
GS_CONTROL_LEASE_S=900                       # an arm lease expires after this
GS_GATE_GUARD_S=300                          # refuse control within this of a scheduled job
GS_GATE_MAX_STALE_S=120                      # SatNOGS status older than this fails the gate closed
GS_TRACK_DEADBAND_DEG=2.0                    # SatNOGS itself uses 4 deg; never alarm below ~5
GS_PARK_AZ=0
GS_PARK_EL=0

# ---------------------------------------------------------------- cameras
GS_GO2RTC_URL=http://video:1984
GS_CAMERA_HOST=10.90.36.130
CAMERA_USER=admin
CAMERA_PASSWORD_FILE=/run/secrets/camera_password
# For `docker compose` variable substitution in deploy/go2rtc/go2rtc.yaml:
CAM_HOST=10.90.36.130
CAM_USER=admin
CAM_PASS=changeme

# ---------------------------------------------------------------- grafana (embedded)
GS_GRAFANA_BASE=https://dashboard.knacksat.com/telemetry
GS_GRAFANA_UID=knacksat-telemetry-optimized-v3
GS_GRAFANA_SLUG=knacksat-satellite-telemetry-monitor
GS_GRAFANA_PANELS=200,1,3,6                  # beacon age, batt V, solar power, batt temp
GS_GRAFANA_RANGE=now-6h
# Template variables their dashboard needs. DS_INFLUXDB picks the datasource;
# panels loaded without it render empty.
GS_GRAFANA_VARS=DS_INFLUXDB=influxdb,callsign=All,gs_id=All
GS_GRAFANA_TOKEN=                            # empty today (anon access). Fill in if they lock it down.

# ---------------------------------------------------------------- satnogs
GS_SATNOGS_NETWORK=https://network.satnogs.org/api
GS_SATNOGS_DB=https://db.satnogs.org/api
GS_SATNOGS_JOBS_POLL_S=60
GS_SATNOGS_OBS_POLL_S=120
GS_SATNOGS_STATION_POLL_S=60
# Optional, and worth having. The Decoded frames panel prefers db.satnogs.org
# /telemetry/, which refuses anonymous requests and is the only source that
# carries DECODED FIELDS — named scalars like battery voltage. Without a token
# the panel falls back to SatNOGS Network, where the demodulated frames
# themselves are public: it stays full, says so, and shows bytes and AX.25
# addressing rather than named values. Everything else here is public either
# way. Get a token from your SatNOGS DB account under Settings -> API key.
GS_SATNOGS_DB_TOKEN=
GS_TELEMETRY_TTL_S=300                       # frames only appear during a pass
GS_WATERFALL_TTL_S=300                       # only changes when a pass uploads

# ---------------------------------------------------------------- station schedule
# The Station Schedule tab plans AND books station 5024's own observations by
# running the Libre Space Foundation's official `satnogs-auto-scheduler` as a
# separate process. Both SatNOGS tokens it needs are entered in the dashboard's
# own schedule settings, not here - and it needs BOTH even for a dry run,
# because that tool validates its whole config before it checks the dry-run flag.
#
# These two are how long that child process may run, and they are backstops
# against a hang rather than tuning knobs. A first run on a cold cache
# genuinely takes minutes - the tool refetches every transmitter's statistics
# and says so - and its booking POST carries no timeout of its own.
GS_SCHEDULE_TIMEOUT_S=1800                   # whole run; kill after this
GS_SCHEDULE_IDLE_TIMEOUT_S=900               # kill after this long with NO output
# How the child is started. "module" runs it through this same interpreter,
# which needs no PATH and lets us pre-seed the logging format so severity is
# visible; "script" falls back to the installed schedule_single_station binary.
GS_SCHEDULE_LAUNCHER=module
# Blank follows GS_MOCK. Set to 0 to run the REAL scheduler while the rotator
# and cameras stay simulated - which is what you want on a box where the
# rotator must not be touched. GS_MOCK=0 would un-mock everything.
# This decides whether a run STARTS the tool; whether it books is the
# separate DRY RUN / RUN NOW choice in the panel.
GS_SCHEDULE_MOCK=
# These two only SEED a fresh schedule_config.json the first time one is
# written. After that the dashboard's own Auto run section is authoritative and
# changing these has no effect.
GS_SCHEDULE_HOURS=24.0                       # matches the station's proven run_scheduler
GS_SCHEDULE_POLL_S=1800                      # seeds the auto-run interval
# How much booking history to read back when reporting what a run did.
GS_SCHEDULE_HISTORY_PAGES=12

# ---------------------------------------------------------------- network campaign
# Asking OTHER people's SatNOGS stations to record KNACKSAT-2. The token that
# does it is NOT set here - it is entered in the dashboard's own schedule
# settings. "Not here" is not "nowhere", though: the dashboard writes it, in
# plaintext, to schedule_config.json under GS_DATA_DIR. Treat that file as a
# secret. It is gitignored, and backend/.dockerignore keeps it out of the image
# build context. These are only the throttles.
# Daily is as often as is useful: SatNOGS refuses any booking more than ~48h out.
GS_CAMPAIGN_POLL_S=86400
GS_CAMPAIGN_MAX_PER_STATION=2                # backstop, not a tuning knob
GS_CAMPAIGN_MAX_TOTAL=150                    # per run, across all stations
# Blank follows GS_MOCK. Set to 0 to run Network Campaign against real SatNOGS
# while the rotator, cameras and Station Schedule all stay mocked.
GS_CAMPAIGN_MOCK=

# ---------------------------------------------------------------- rig (read-only)
# Station 5024 runs `rigctld -m 1 -t 4534` — a Hamlib "Dummy" rig that
# satnogs-client writes the Doppler-corrected downlink to during a pass. The SDR
# itself is tuned inside the gr-satnogs flowgraph and has no network interface,
# so this is the only outside view of what the receiver is doing. The dashboard
# only ever reads it: satnogs-client owns this rig while a pass is running.
# Set GS_RIGCTLD_ENABLED=0 on a station that drives its SDR entirely in the
# flowgraph and has no rigctld at all.
GS_RIGCTLD_HOST=10.90.36.140
GS_RIGCTLD_PORT=4534
GS_RIGCTLD_ENABLED=1
