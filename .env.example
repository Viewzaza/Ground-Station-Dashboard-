# Copy to .env and edit. .env is gitignored and must never be committed.
# On the Linux server the only flag you normally flip is GS_MOCK.

# ---------------------------------------------------------------- mode
GS_MOCK=1                 # 1 = simulators (Windows dev). 0 = real hardware.
GS_OFFLINE=0              # 1 = serve fixtures instead of hitting the internet
GS_LOG_LEVEL=info

# ---------------------------------------------------------------- station
GS_STATION_ID=5024
GS_STATION_NAME=INSTED-Ground Station(UHF)
GS_STATION_LAT=13.823781779271652
GS_STATION_LON=100.51295302800892
GS_STATION_ALT_M=60
GS_STATION_GRID=OK03gt
# Match the station's own SatNOGS settings, or our pass times will not agree
# with the schedule it records to. Station 5024: min_horizon 0, min_culmination 10.
GS_MIN_ELEVATION_DEG=0.0
GS_MIN_CULMINATION_DEG=10.0
GS_TIMEZONE=Asia/Bangkok

# ---------------------------------------------------------------- satellites
GS_DEFAULT_NORAD=67683                       # KNACKSAT-2
GS_PINNED_NORAD=67683                        # always in the selector, comma separated
GS_CELESTRAK_GROUP=amateur                   # full amateur list for the selector
GS_TLE_TTL_S=7200                            # Celestrak 403s below this. Do not lower.
GS_TLE_STALE_WARN_D=7
GS_TLE_STALE_CRIT_D=14

# ---------------------------------------------------------------- rotator
# rigctld defaults to 4532 (RADIO), rotctld to 4533 (ROTATOR).
# Resolve on site with deploy/commissioning/01-rotator-port.sh before trusting this.
GS_ROTCTLD_HOST=10.90.36.140
GS_ROTCTLD_PORT=4533
GS_ROTCTLD_PROTOCOL=auto                     # auto | rotctld | rigctld — auto refuses to poll a rig
GS_ROTATOR_POLL_HZ=1.0                       # NOT 2.0: 600-baud ROT2PROG cannot sustain it
GS_ROTATOR_BACKOFF_MIN_S=5
GS_ROTATOR_BACKOFF_MAX_S=10
GS_MOCK_FAULT_PERIOD_S=600                   # mock injects an RPRT -5 outage this often

# ---------------------------------------------------------------- rotator control
# Control is refused unless ALL gates pass. Default off; turn on deliberately.
GS_ROTATOR_CONTROL_ENABLED=0
GS_CONTROL_LEASE_S=900                       # an arm lease expires after this
GS_GATE_GUARD_S=300                          # refuse control within this of a scheduled job
GS_GATE_MAX_STALE_S=120                      # SatNOGS status older than this fails the gate closed
GS_TRACK_DEADBAND_DEG=2.0                    # SatNOGS itself uses 4 deg; never alarm below ~5
GS_PARK_AZ=0
GS_PARK_EL=0

# ---------------------------------------------------------------- cameras
GS_GO2RTC_URL=http://video:1984
GS_CAMERA_HOST=10.90.36.130
CAMERA_USER=admin
CAMERA_PASSWORD_FILE=/run/secrets/camera_password
# For `docker compose` variable substitution in deploy/go2rtc/go2rtc.yaml:
CAM_HOST=10.90.36.130
CAM_USER=admin
CAM_PASS=changeme

# ---------------------------------------------------------------- grafana (embedded)
GS_GRAFANA_BASE=https://dashboard.knacksat.com/telemetry
GS_GRAFANA_UID=knacksat-telemetry-optimized-v3
GS_GRAFANA_SLUG=knacksat-satellite-telemetry-monitor
GS_GRAFANA_PANELS=200,1,3,6                  # beacon age, batt V, solar power, batt temp
GS_GRAFANA_RANGE=now-6h
# Template variables their dashboard needs. DS_INFLUXDB picks the datasource;
# panels loaded without it render empty.
GS_GRAFANA_VARS=DS_INFLUXDB=influxdb,callsign=All,gs_id=All
GS_GRAFANA_TOKEN=                            # empty today (anon access). Fill in if they lock it down.

# ---------------------------------------------------------------- satnogs
GS_SATNOGS_NETWORK=https://network.satnogs.org/api
GS_SATNOGS_DB=https://db.satnogs.org/api
GS_SATNOGS_JOBS_POLL_S=60
GS_SATNOGS_OBS_POLL_S=120
GS_SATNOGS_STATION_POLL_S=60
# Only needed for db.satnogs.org /telemetry/ and /artifacts/. Everything this
# dashboard uses is public, so leave blank unless you add those endpoints.
GS_SATNOGS_DB_TOKEN=
