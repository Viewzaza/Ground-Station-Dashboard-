# secrets
.env
.env.*
!.env.example
deploy/secrets/*
!deploy/secrets/.gitkeep

# runtime state
backend/data/*
!backend/data/.gitkeep
caddy_data/
caddy_config/

# vendored assets fetched by tools/fetch_vendor.sh
frontend/js/vendor/three/
frontend/assets/earth-*.jpg
# Fetched by tools/fetch_vendor.sh; 1.6 MB of coordinates, and the committed
# 110m tier is a working fallback. See the LAND_TIERS note in js/panels/map2d.js.
frontend/assets/ne_50m_land.json

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# satnogs-auto-scheduler's own test fixtures, fetched on demand by
# backend/tests/data/capture/fetch_upstream_fixtures.sh. Not committed: that
# project is AGPL-3.0 and this one is MIT.
backend/tests/data/capture/upstream_fixtures/
